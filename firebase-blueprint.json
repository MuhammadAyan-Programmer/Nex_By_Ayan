{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered contributor or admin user profile in Nexora Workforce",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique user identifier or UID" },
        "firstName": { "type": "string", "description": "First name of user" },
        "lastName": { "type": "string", "description": "Last name of user" },
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "phone": { "type": "string", "description": "Contact phone number" },
        "country": { "type": "string", "description": "Country of residence" },
        "languages": { "type": "array", "description": "Spoken languages" },
        "languageProficiency": { "type": "object", "description": "Language proficiency map" },
        "skills": { "type": "array", "description": "User professional skills" },
        "experience": { "type": "string", "description": "User background and experience" },
        "role": { "type": "string", "enum": ["contributor", "admin"], "description": "Account role" },
        "isEmailVerified": { "type": "boolean", "description": "Email verified status" },
        "profileStatus": { "type": "string", "description": "Profile completion stage" },
        "avatar": { "type": "string", "description": "User avatar initials or URL" },
        "status": { "type": "string", "enum": ["active", "suspended", "pending"], "description": "Account status" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["id", "firstName", "lastName", "email", "role", "status", "createdAt"]
    },
    "Application": {
      "title": "Application",
      "description": "Contributor job and project application",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Application document ID" },
        "projectId": { "type": "string", "description": "Project ID applied to" },
        "projectName": { "type": "string", "description": "Project name" },
        "projectCategory": { "type": "string", "description": "Project category" },
        "userId": { "type": "string", "description": "Applicant user UID" },
        "userName": { "type": "string", "description": "Applicant full name" },
        "userEmail": { "type": "string", "format": "email", "description": "Applicant email" },
        "phone": { "type": "string", "description": "Applicant phone number" },
        "country": { "type": "string", "description": "Applicant country" },
        "languages": { "type": "array", "description": "Applicant languages" },
        "languageProficiency": { "type": "object", "description": "Applicant language proficiency" },
        "experience": { "type": "string", "description": "Applicant experience" },
        "skills": { "type": "array", "description": "Applicant skills" },
        "cvLink": { "type": "string", "description": "CV or resume URL" },
        "status": { "type": "string", "enum": ["Applied", "Under Review", "Shortlisted", "Accepted", "Rejected"], "description": "Application status" },
        "appliedDate": { "type": "string", "description": "Submission date" }
      },
      "required": ["id", "projectId", "userId", "userName", "userEmail", "status", "appliedDate"]
    },
    "Project": {
      "title": "Project",
      "description": "Workforce translation and AI data project",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Project ID" },
        "name": { "type": "string", "description": "Project title" },
        "category": { "type": "string", "description": "Project category" },
        "projectType": { "type": "string", "description": "Project type" },
        "description": { "type": "string", "description": "Project description" },
        "language": { "type": "string", "description": "Project languages" },
        "country": { "type": "string", "description": "Target country or Global" },
        "skillsRequired": { "type": "array", "description": "Skills required" },
        "requiredContributors": { "type": "number", "description": "Required contributors count" },
        "approvedContributors": { "type": "number", "description": "Approved contributors count" },
        "status": { "type": "string", "enum": ["Open", "In Progress", "Completed", "Paused"], "description": "Project status" },
        "paymentType": { "type": "string", "description": "Payment model" },
        "ratePay": { "type": "string", "description": "Rate pay text" },
        "createdAt": { "type": "string", "description": "Creation date" }
      },
      "required": ["id", "name", "category", "status", "createdAt"]
    },
    "SystemConfig": {
      "title": "SystemConfig",
      "description": "System wide configuration including maintenance mode schedule",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "description": "Whether maintenance mode is enabled" },
        "startDateTime": { "type": "string", "description": "Scheduled start time" },
        "endDateTime": { "type": "string", "description": "Scheduled end time" },
        "title": { "type": "string", "description": "Maintenance notice headline" },
        "message": { "type": "string", "description": "Maintenance notice description" },
        "lastUpdated": { "type": "string", "description": "Last updated timestamp" },
        "updatedBy": { "type": "string", "description": "Administrator email who last updated" }
      }
    },
    "QuickTask": {
      "title": "QuickTask",
      "description": "Lightweight quick tasks published by administrator that users can participate directly in",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Task ID" },
        "title": { "type": "string", "description": "Task headline" },
        "description": { "type": "string", "description": "Short task summary" },
        "instructions": { "type": "string", "description": "Detailed task instructions" },
        "submissionRequirements": { "type": "string", "description": "Instructions on what to submit" },
        "referenceLink": { "type": "string", "description": "Optional reference URL" },
        "reward": { "type": "string", "description": "Optional reward/compensation text" },
        "status": { "type": "string", "enum": ["active", "closed"], "description": "Status of task" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["id", "title", "description", "instructions", "submissionRequirements", "status", "createdAt"]
    },
    "QuickTaskSubmission": {
      "title": "QuickTaskSubmission",
      "description": "Contributor submission response for a specific quick task",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Submission ID" },
        "taskId": { "type": "string", "description": "Associated quick task ID" },
        "taskTitle": { "type": "string", "description": "Title of associated task" },
        "userId": { "type": "string", "description": "Submitter user ID" },
        "userName": { "type": "string", "description": "Submitter full name" },
        "userEmail": { "type": "string", "format": "email", "description": "Submitter email" },
        "submittedUrl": { "type": "string", "description": "Submitted link or URL" },
        "submittedText": { "type": "string", "description": "Submitted text response" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"], "description": "Review status" },
        "submittedAt": { "type": "string", "description": "Submission timestamp" },
        "adminFeedback": { "type": "string", "description": "Review notes or feedback from admin" }
      },
      "required": ["id", "taskId", "userId", "userName", "userEmail", "status", "submittedAt"]
    },
    "ProjectPaymentRecord": {
      "title": "ProjectPaymentRecord",
      "description": "Admin notebook manual project and batch payment records",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Record ID" },
        "projectName": { "type": "string", "description": "Project title" },
        "projectBatch": { "type": "string", "description": "Batch name or number" },
        "totalTasksSubmitted": { "type": "number", "description": "Total tasks submitted" },
        "totalApprovedTasks": { "type": "number", "description": "Total approved tasks count" },
        "totalPaymentDistributed": { "type": "number", "description": "Total USD payment distributed" },
        "paymentDate": { "type": "string", "description": "Date of payment distribution (YYYY-MM-DD)" },
        "additionalNotes": { "type": "string", "description": "Extra administrative notes" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["id", "projectName", "projectBatch", "totalTasksSubmitted", "totalPaymentDistributed", "paymentDate", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/User",
      "description": "User profiles registered on Nexora Workforce"
    },
    "/applications/{applicationId}": {
      "schema": "#/entities/Application",
      "description": "Applications submitted to projects"
    },
    "/projects/{projectId}": {
      "schema": "#/entities/Project",
      "description": "Workforce projects"
    },
    "/quick_tasks/{taskId}": {
      "schema": "#/entities/QuickTask",
      "description": "Quick tasks published by admin"
    },
    "/quick_task_submissions/{submissionId}": {
      "schema": "#/entities/QuickTaskSubmission",
      "description": "Contributor submissions for quick tasks"
    },
    "/project_payment_records/{recordId}": {
      "schema": "#/entities/ProjectPaymentRecord",
      "description": "Admin-only manual project payment history records"
    },
    "/system/{docId}": {
      "schema": "#/entities/SystemConfig",
      "description": "System settings and maintenance schedule"
    }
  }
}
